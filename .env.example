REDIS_PORT_INTERNAL=6379
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8088,http://127.0.0.1:4200,http://127.0.0.1:8088

# Development-only authentication material. Generate unique random values outside local demos.
AUTH_JWT_ISSUER=schoolz-local
