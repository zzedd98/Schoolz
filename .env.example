MINIO_CONSOLE_PORT=19001
S3_BUCKET=school-erp-dev

BACKEND_HOST_PORT=18080
FRONTEND_PORT=4200
HTTP_PORT=8088

SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://postgres:5432/school_erp
DB_USERNAME=school_erp
DB_PASSWORD=school_erp_dev_only
