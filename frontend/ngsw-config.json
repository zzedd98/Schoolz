{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "public-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**", "!/actuator/**", "!/swagger-ui/**"]
}
