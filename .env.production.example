# Copy to .env.production and replace every CHANGE_ME value before deployment.
POSTGRES_DB=schoolz
POSTGRES_USER=schoolz
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

S3_ENDPOINT=https://s3.example.ma
S3_ACCESS_KEY=CHANGE_ME_STORAGE_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STORAGE_SECRET
S3_BUCKET=schoolz-production

HTTP_PORT=8080
ALLOWED_ORIGINS=https://schoolz.example.ma

AUTH_JWT_ISSUER=https://schoolz.example.ma
AUTH_JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
AUTH_TOKEN_PEPPER=CHANGE_ME_AT_LEAST_64_OTHER_RANDOM_CHARACTERS
SCHOOLZ_PROVISIONING_KEY=CHANGE_ME_AT_LEAST_64_NEW_RANDOM_CHARACTERS
SCHOOLZ_PUBLIC_BASE_URL=https://schoolz.example.ma

# Demo and sandbox features stay disabled in production.
DEMO_SEED_ENABLED=false
DEMO_EXPOSE_TOKENS=false
AUTH_SECURE_COOKIES=true
